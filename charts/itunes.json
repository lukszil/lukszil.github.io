{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "apiData" },
  "transform": [
    {"calculate": "datum.trackTimeMillis / 60000", "as": "minutes"}
  ],
  "mark": "circle",
  "encoding": {
    "x": {
      "field": "minutes", "type": "quantitative", 
      "title": "Dal hossza (perc)",
      "scale": {"zero": false},
      "axis": {"labelColor": "#9ca3af", "titleColor": "#9ca3af"}
    },
    "y": {
      "field": "trackPrice", "type": "quantitative", 
      "title": "Ár ($)",
      "axis": {"labelColor": "#9ca3af", "titleColor": "#9ca3af"}
    },
    "size": {"value": 100},
    "color": {
      "field": "trackExplicitness", "type": "nominal", 
      "title": "Szöveg",
      "scale": {"domain": ["explicit", "cleaned", "notExplicit"], "range": ["#3B0F70", "#ffffff", "#60a5fa"]},
      "legend": {"labelColor": "#9ca3af", "titleColor": "#fff"}
    },
    "tooltip": [
      {"field": "trackName", "title": "Cím"},
      {"field": "artistName", "title": "Előadó"},
      {"field": "minutes", "title": "Hossz", "format": ".2f"}
    ]
  },
  "config": {"view": {"stroke": null}, "background": "transparent"}

}
