{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": { "name": "myData" },
  "width": "container",
  "height": 280,
  "layer": [
    {
      "mark": {"type": "circle", "opacity": 0.8, "size": 80},
      "encoding": {
        "x": {
          "field": "year", "type": "ordinal", 
          "title": null, 
          "axis": {"labelAngle": 0, "tickCount": 5} 
        },
        "y": {
          "field": "minutes", "type": "quantitative",
          "title": "Perc",
          "scale": {"domain": [0, 8], "clamp": true}, 
          "axis": {"grid": true}
        },
        "color": {
          "field": "explicitness", "type": "nominal",
          "scale": {
            "domain": ["explicit", "cleaned", "notExplicit"], 
            "range": ["#8C2981", "#ffffff", "#60a5fa"] 
          },
          "legend": null 
        },
        "tooltip": [
          {"field": "title", "title": "Cím"},
          {"field": "minutes", "title": "Hossz", "format": ".2f"},
          {"field": "year", "title": "Év"}
        ]
      }
    },
    {
      "mark": {"type": "line", "point": false, "color": "#f0f6fc", "strokeWidth": 2, "strokeDash": [4,4]},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {"aggregate": "mean", "field": "minutes"}
      }
    }
  ],
  "config": {"view": {"stroke": null}, "background": "transparent"}
}
